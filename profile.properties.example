# Optional: copy to profile.properties to build your own API keys into the app.
# Without it the app asks for the keys on first start (or reads TMDB_API_KEY etc. from the environment).
# Ant reads this file before app.properties, so these values win. Never publish a build that contains keys.
# Get your own free keys:
#   TheMovieDB  https://www.themoviedb.org/settings/api
#   Fanart.tv   https://fanart.tv/get-an-api-key/
#   OMDb        https://www.omdbapi.com/apikey.aspx
#   AcoustID    https://acoustid.org/new-application
apikey.fanart.tv:
apikey.thetvdb:
apikey.themoviedb:
apikey.omdb:
apikey.acoustid:
apikey.anidb:
apikey.opensubtitles:
